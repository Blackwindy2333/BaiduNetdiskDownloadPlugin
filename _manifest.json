{
  "manifest_version": 2,
  "id": "blackbee.baidu-pan",
  "version": "2.0.0",
  "name": "百度网盘下载助手",
  "description": "浏览百度网盘分享链接、按需精确转存，并通过 BaiduPCS-Go 下载后发送到聊天；支持管理员白名单、镜像安装、NapCat/SnowLuma 统一适配器、持久化配置与完整日志。",
  "author": {
    "name": "BlackBee114514",
    "url": "https://github.com/Blackwindy2333"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/Blackwindy2333/BaiduNetdiskDownloadPlugin",
    "issues": "https://github.com/Blackwindy2333/BaiduNetdiskDownloadPlugin/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.14.0",
    "max_version": "999.999.999"
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.custom"
  ],
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "download"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
